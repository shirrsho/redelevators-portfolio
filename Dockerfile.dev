# syntax=docker/dockerfile:1

# Local development image: runs `next dev` with hot-reload.
# Source is bind-mounted in by docker-compose.dev.yml, so this image only
# needs to install dependencies.
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["npm", "run", "dev"]

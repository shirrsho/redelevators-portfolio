# Copy this file to `.env.local` for local Docker development, then fill in
# real values.
#
# The app currently reads no environment variables itself, but this file
# gives docker-compose.dev.yml something to load. Production settings live in
# the Hostinger panel's Environment box, not here (README.md, Deployment).

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# NEXT_PUBLIC_SITE_URL=https://example.com

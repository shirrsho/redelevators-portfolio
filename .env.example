# Copy this file to `.env.local` for local Docker development and to `.env`
# for production deployment, then fill in real values.
#
# The app currently reads no environment variables itself, but this file
# gives Docker Compose something to load and is the template the deploy
# workflow writes to `.env` on the VPS from GitHub Actions secrets.

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# NEXT_PUBLIC_SITE_URL=https://example.com
